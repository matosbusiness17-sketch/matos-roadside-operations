# ==============================================================================
# Matos Systems — Roadside Operations & Dispatch System
# Environment Configuration Template
#
# IMPORTANT:
# This file serves as a template. Copy this file to '.env.local' located at the
# Next.js PROJECT ROOT:
#   matos-roadside-operations/.env.local
# DO NOT place this file inside the /supabase directory.
# Never commit '.env.local' to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Integration (Phase 2 Foundation)
# ------------------------------------------------------------------------------
# The public Supabase URL and public anonymous / publishable key for browser/server connection.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project-ref.supabase.co

# Public client key: Either NEXT_PUBLIC_SUPABASE_ANON_KEY or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-supabase-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=placeholder-supabase-publishable-key

# ------------------------------------------------------------------------------
# Mapbox Operational Mapping (Phase 5 Foundation)
# ------------------------------------------------------------------------------
# Public Mapbox access token for client-side operational map rendering.
# Must be a public (pk-prefixed) token. Never expose secret (sk-prefixed) tokens.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Telephony & Voice Intake (Future Phase 9)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# VAPI_API_KEY=
